# Formspree form ID for the contact form (public, client-side)
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical site URL used for SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (Meta)
# Token permanente o temporal de System User
WHATSAPP_TOKEN=
# Phone number ID del número de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# Token que vos definís para verificar el webhook
WHATSAPP_VERIFY_TOKEN=laxmar_verify_change_me
